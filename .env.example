# ==============================================================================
# ShopEase Environment Configuration (.env.example)
# Copy this file to .env.local and replace with your real Supabase credentials.
# In demo/local preview mode without these keys, ShopEase runs with safe fallback data.
# ==============================================================================

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER expose with NEXT_PUBLIC)
# Used for verified administrative backend operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Payment Gateway Configuration (Test Mode Sandbox)
# If left empty, ShopEase provides Cash on Delivery (COD) and real test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
